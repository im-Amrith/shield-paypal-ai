# Copy to .env.local and fill in. The app runs without any of these (mock PayPal + rule-based AI).

# PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_WEBHOOK_ID=
# SANDBOX_BUYER_EMAIL=   your sandbox *personal* account (Testing Tools -> Sandbox Accounts). The seeded client Dana and the
#                        invoice form use it, so invoices land in that sandbox inbox and you can pay them there.

# LLM: set ONE of these
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   (Groq / OpenRouter / Gemini OpenAI-compatible URLs work too)
# OPENAI_VISION_MODEL=qwen/qwen3.8-27b   (used instead of OPENAI_MODEL when a call has images, e.g. a scam screenshot; Groq: max 3 images, 4 MB each)

# Shopping agent products (trychannel3.com/developers). Without it, /shop uses a small labeled sample list.
CHANNEL3_API_KEY=

# Email (resend.com). Without it, emails go to the in-app demo outbox.
RESEND_API_KEY=
# EMAIL_FROM=Shield <onboarding@resend.dev>
# DEMO_EMAIL_OVERRIDE=you@example.com   (send every demo email to yourself)

# App
APP_URL=http://localhost:3000
# CRON_SECRET=
# SHIELD_DB_PATH=/data/db.json   (Render persistent disk; see render.yaml)
# DEMO_CONTROLS=off
